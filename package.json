{
  "name": "karaoke",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/preparar-videos-publicos.ts",
    "build": "next build",
    "start": "next start",
    "desktop:dev": "concurrently -k \"next dev\" \"wait-on tcp:3000 && electron .\"",
    "desktop:build": "cross-env NEXT_DESKTOP_EXPORT=1 next build",
    "desktop:dist": "npm run desktop:build && electron-builder --win portable",
    "lint": "eslint",
    "review:canciones": "powershell -ExecutionPolicy Bypass -File scripts/abrir-revision-canciones.ps1",
    "generate:youtube-ids": "tsx scripts/generar-youtube-ids.ts",
    "download:canciones": "tsx scripts/descargar-canciones.ts",
    "normalize:canciones": "tsx scripts/normalizar-canciones.ts"
  },
  "dependencies": {
    "@types/matter-js": "^0.20.2",
    "canvas-confetti": "^1.9.4",
    "matter-js": "^0.20.0",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serve-handler": "^6.1.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.karaoke.desktop",
    "productName": "Karaoke",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json",
      "!app/**/*",
      "!scripts/**/*",
      "!public/**/*",
      "!downloads/**/*",
      "!cancionesnormalizadas/**/*",
      "!README.md",
      "!tsconfig.json",
      "!tsconfig.tsbuildinfo",
      "!eslint.config.mjs",
      "!postcss.config.mjs",
      "!next.config.ts"
    ],
    "asar": false,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
